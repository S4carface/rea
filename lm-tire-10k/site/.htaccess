# GENERATED by tools/build3.py. Apache / LiteSpeed hosting (Hostinger and similar).
Options -Indexes
ErrorDocument 404 /404.html
DirectoryIndex index.html
AddType application/manifest+json .webmanifest
AddType text/vcard .vcf

# never serve notes, source or settings files if they are uploaded by mistake
<FilesMatch "\.(md|py|sh|bak|log|ini|env|json\.sample|php\.sample)$">
Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine On
# always use https
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), payment=(), usb=(), geolocation=(), interest-cohort=()"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://i.ytimg.com; media-src 'self'; connect-src 'self' https://vpic.nhtsa.dot.gov https://api.open-meteo.com; frame-src https://www.google.com https://www.youtube-nocookie.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
<FilesMatch "\.(css|js|webp|jpg|png|svg|mp4|mp3|woff2|webmanifest)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "(\.html|hours\.js|notice\.json|sw\.js)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
